<UserControl x:Class="TimeBridge.App.Controls.DateField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <TextBox x:Name="Box" Padding="10,6,40,6" MaxLength="10"
                 TextChanged="OnTextChanged" LostFocus="OnLostFocus"
                 ToolTip="Date in DD-MM-YYYY format" />
        <Button x:Name="CalendarButton" HorizontalAlignment="Right" VerticalAlignment="Center"
                Margin="0,0,4,0" Width="30" Height="26" Padding="0"
                Background="Transparent" BorderThickness="0"
                FontFamily="{StaticResource IconFont}" Content="&#xE787;" FontSize="14"
                Click="OnCalendarClick" ToolTip="Pick from calendar" />
        <Popup x:Name="Pop" PlacementTarget="{Binding ElementName=Box}" Placement="Bottom"
               StaysOpen="False" AllowsTransparency="True">
            <Border Background="{DynamicResource ApplicationBackgroundBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="6" Margin="0,4,0,0">
                <Calendar x:Name="Cal" SelectedDatesChanged="OnCalendarPicked" />
            </Border>
        </Popup>
    </Grid>
</UserControl>
