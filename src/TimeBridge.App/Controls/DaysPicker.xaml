<UserControl x:Class="TimeBridge.App.Controls.DaysPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- DataContext is a DaysEditor -->
    <UniformGrid Rows="1">
        <ToggleButton Content="Mon" IsChecked="{Binding Mon, Mode=TwoWay}" Margin="0,0,4,0" Padding="0,6" />
        <ToggleButton Content="Tue" IsChecked="{Binding Tue, Mode=TwoWay}" Margin="0,0,4,0" Padding="0,6" />
        <ToggleButton Content="Wed" IsChecked="{Binding Wed, Mode=TwoWay}" Margin="0,0,4,0" Padding="0,6" />
        <ToggleButton Content="Thu" IsChecked="{Binding Thu, Mode=TwoWay}" Margin="0,0,4,0" Padding="0,6" />
        <ToggleButton Content="Fri" IsChecked="{Binding Fri, Mode=TwoWay}" Margin="0,0,4,0" Padding="0,6" />
        <ToggleButton Content="Sat" IsChecked="{Binding Sat, Mode=TwoWay}" Margin="0,0,4,0" Padding="0,6" />
        <ToggleButton Content="Sun" IsChecked="{Binding Sun, Mode=TwoWay}" Padding="0,6" />
    </UniformGrid>
</UserControl>
