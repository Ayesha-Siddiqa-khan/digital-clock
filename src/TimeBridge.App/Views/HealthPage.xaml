<UserControl x:Class="TimeBridge.App.Views.HealthPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ctl="clr-namespace:TimeBridge.App.Controls">
    <Grid x:Name="Page" Margin="20,10,32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="440" />
        </Grid.ColumnDefinitions>

        <Grid Grid.ColumnSpan="3" Margin="0,0,0,16">
            <StackPanel HorizontalAlignment="Left" MaxWidth="760">
                <TextBlock Text="Health breaks" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                           Text="Long hours at the screen? Set reminders to drink water, eat, walk, rest your eyes or take a screen break. Use a fixed time (walk at 12:00) or repeat inside your working hours (every 2 hours from 9:00 to 16:00)." />
            </StackPanel>
            <Button Content="Add a starter plan for a 9–4 desk day" Command="{Binding StarterPlanCommand}" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="14,6" />
        </Grid>

        <!-- reminder list -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Emoji}" FontFamily="Segoe UI Emoji" FontSize="24" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding WhenText}" Margin="0,2,12,0" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding DaysText}" Style="{StaticResource Hint}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <CheckBox IsChecked="{Binding IsEnabled, Mode=OneWay}" ToolTip="On / off" MinWidth="0"
                                                  Command="{Binding DataContext.ToggleCommand, ElementName=Page}" CommandParameter="{Binding}" />
                                        <Button Content="Edit" Padding="12,4" Margin="6,0,0,0"
                                                Command="{Binding DataContext.EditCommand, ElementName=Page}" CommandParameter="{Binding}" />
                                        <Button Content="Delete" Padding="12,4" Margin="6,0,0,0"
                                                Command="{Binding DataContext.DeleteCommand, ElementName=Page}" CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="No reminders yet. Add one on the right, or start with the starter plan above.">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </ScrollViewer>

        <!-- form -->
        <ScrollViewer Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock FontSize="18" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="New reminder" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="Text" Value="Edit reminder" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="What should I remind you about?" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Kinds}" DisplayMemberPath="Label" SelectedValuePath="Id"
                              SelectedValue="{Binding Kind}" HorizontalAlignment="Stretch" />

                    <TextBlock Text="Title" Style="{StaticResource FieldLabel}" />
                    <ui:TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Message (optional)" Style="{StaticResource FieldLabel}" />
                    <ui:TextBox Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Leave empty to use the default message" />

                    <TextBlock Text="When" Style="{StaticResource FieldLabel}" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="Repeat during my working hours" IsChecked="{Binding Repeating}" GroupName="mode" />
                    </StackPanel>
                    <RadioButton Content="Once at a fixed time" GroupName="mode"
                                 IsChecked="{Binding Repeating, Converter={StaticResource InverseBool}}" />

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding StartLabel}" Style="{StaticResource FieldLabel}" />
                            <ctl:TimePicker Value="{Binding Start, Mode=TwoWay}" HorizontalAlignment="Left" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Visibility="{Binding Repeating, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Window ends" Style="{StaticResource FieldLabel}" />
                            <ctl:TimePicker Value="{Binding End, Mode=TwoWay}" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Visibility="{Binding Repeating, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Repeat every" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Intervals}" DisplayMemberPath="Label" SelectedValuePath="Minutes"
                                  SelectedValue="{Binding Interval}" HorizontalAlignment="Left" MinWidth="200" />
                    </StackPanel>

                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Hint}" Margin="0,10,0,0" Foreground="{StaticResource AccentSoft}" />

                    <TextBlock Text="Days" Style="{StaticResource FieldLabel}" />
                    <ctl:DaysPicker DataContext="{Binding Days}" />

                    <CheckBox Content="Turned on" IsChecked="{Binding Active}" Margin="0,12,0,0" />

                    <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,10,0,0"
                               Visibility="{Binding Error, Converter={StaticResource NotNullToVis}}" />

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:Button Content="{Binding SaveText}" Command="{Binding SaveCommand}" Appearance="Primary" HorizontalAlignment="Stretch" />
                        <Button Grid.Column="2" Content="Preview" Command="{Binding TestReminderCommand}" Padding="16,6" ToolTip="Show how this reminder will look" />
                    </Grid>
                    <Button Content="Cancel editing" Command="{Binding CancelEditCommand}" HorizontalAlignment="Stretch" Margin="0,8,0,0"
                            Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
