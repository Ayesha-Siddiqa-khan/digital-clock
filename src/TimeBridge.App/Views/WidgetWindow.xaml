<Window x:Class="TimeBridge.App.Views.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TimeBridge Clock" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Topmost="{Binding IsPinned}" Opacity="{Binding WidgetOpacity}"
        Width="340" Height="326"
        Icon="pack://application:,,,/Assets/app.ico">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#F1F5F9" />
        <SolidColorBrush x:Key="Muted" Color="#8B9BC0" />
        <SolidColorBrush x:Key="Accent" Color="#A5B4FC" />
        <SolidColorBrush x:Key="Pink" Color="#F472B6" />

        <Style x:Key="WidgetIconButton" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Foreground" Value="#C7D2FE" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33426E" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#415180" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Background" Value="#222E4F" />
        </Style>

        <Style x:Key="ChromeButton" TargetType="Button" BasedOn="{StaticResource WidgetIconButton}">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="22" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style x:Key="ClientRowButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="10,8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A3963" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <!-- Expanded clock -->
        <Viewbox x:Name="ExpandedView" Stretch="Uniform">
            <Grid Width="340" Height="326" Margin="0">
                <Border Margin="8" CornerRadius="16" BorderThickness="1" BorderBrush="#2B3960"
                        MouseLeftButtonDown="OnDragStart">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#141F3B" Offset="0" />
                            <GradientStop Color="#0E1730" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.55" Color="#000000" />
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30" />
                            <RowDefinition Height="42" />
                            <RowDefinition Height="82" />
                            <RowDefinition Height="82" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- chrome strip: brand + collapse / minimise / close -->
                        <Grid Grid.Row="0" Margin="14,6,6,0" Background="Transparent">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="#4ADE80" VerticalAlignment="Center" />
                                <TextBlock Text="TimeBridge" Margin="8,0,0,0" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                                <TextBlock Text="LIVE" Margin="8,2,0,0" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource ChromeButton}" Content="&#xE70D;" Command="{Binding ToggleCollapseCommand}" ToolTip="Collapse to a small bar" />
                                <Button Style="{StaticResource ChromeButton}" Content="&#xE921;" Command="{Binding MinimiseCommand}" ToolTip="Minimise (hide the widget; TimeBridge keeps running)" />
                                <Button Style="{StaticResource ChromeButton}" Content="&#xE8BB;" Command="{Binding CloseCommand}" ToolTip="Close the widget (alarms keep running)" />
                            </StackPanel>
                        </Grid>

                        <!-- subtitle + pin / list / edit -->
                        <Grid Grid.Row="1" Margin="14,0,12,0" Background="Transparent">
                            <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,112,0" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="PinButton" Style="{StaticResource WidgetIconButton}" Content="&#xE718;" Margin="0,0,5,0"
                                        Command="{Binding TogglePinCommand}" ToolTip="Pin: keep the widget on top of other windows" />
                                <Button x:Name="ListButton" Style="{StaticResource WidgetIconButton}" Content="&#xE8FD;" Margin="0,0,5,0"
                                        Click="OnListClick" ToolTip="Switch client" />
                                <Button Style="{StaticResource WidgetIconButton}" Content="&#xE70F;"
                                        Command="{Binding EditCommand}" ToolTip="Edit time zones and widget settings" />
                            </StackPanel>
                        </Grid>

                        <!-- home clock -->
                        <Border Grid.Row="2" Background="#1B2850" Padding="16,8,16,6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding HomeLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                                <TextBlock Text="{Binding HomeOffset}" FontSize="11" Foreground="{StaticResource Accent}" HorizontalAlignment="Right" />
                                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding HomeTime}" FontSize="31" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                                    <TextBlock Text="{Binding HomeAmPm}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="6,0,0,6" VerticalAlignment="Bottom" />
                                </StackPanel>
                                <TextBlock Grid.Row="2" Text="{Binding HomeDate}" FontSize="11" Foreground="{StaticResource Muted}" />
                            </Grid>
                        </Border>

                        <!-- selected client clock -->
                        <Border Grid.Row="3" Background="#131D3A" Padding="16,8,16,6" BorderBrush="#222F55" BorderThickness="0,1,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding ClientLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis" Margin="0,0,60,0" />
                                <TextBlock Text="{Binding ClientOffset}" FontSize="11" Foreground="{StaticResource Accent}" HorizontalAlignment="Right" />
                                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ClientTime}" FontSize="31" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                                    <TextBlock Text="{Binding ClientAmPm}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="6,0,0,6" VerticalAlignment="Bottom" />
                                </StackPanel>
                                <TextBlock Grid.Row="2" Text="{Binding ClientDate}" FontSize="11" Foreground="{StaticResource Muted}" />
                            </Grid>
                        </Border>

                        <!-- next meeting -->
                        <Border Grid.Row="4" Background="#0F1830" CornerRadius="0,0,15,15" Padding="16,9,16,8" BorderBrush="#222F55" BorderThickness="0,1,0,0"
                                Cursor="Hand" MouseLeftButtonUp="OnNextMeetingClick">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="NEXT MEETING" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
                                <TextBlock Text="{Binding NextCountdown}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Accent}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Row="1" Text="{Binding NextTitle}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Row="2" Text="{Binding NextDetail}" FontSize="10.5" Foreground="{StaticResource Muted}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
                <!-- resize grip -->
                <Thumb x:Name="ResizeGrip" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="18" Height="18" Margin="0,0,9,9"
                       Cursor="SizeNWSE" Opacity="0.0" DragDelta="OnResizeDelta" DragCompleted="OnResizeCompleted" ToolTip="Drag to resize">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <Border Background="Transparent">
                                <TextBlock Text="&#xE76F;" FontFamily="{StaticResource IconFont}" FontSize="9" Foreground="#6B7BA6"
                                           HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,3,3" RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform><RotateTransform Angle="45" /></TextBlock.RenderTransform>
                                </TextBlock>
                            </Border>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
            </Grid>
        </Viewbox>

        <!-- Collapsed bar -->
        <Viewbox x:Name="CollapsedView" Stretch="Uniform" Visibility="Collapsed">
            <Grid Width="300" Height="52">
                <Border Margin="6" CornerRadius="14" BorderThickness="1" BorderBrush="#2B3960" Cursor="Hand"
                        MouseLeftButtonDown="OnBarMouseDown" ToolTip="Click to expand · drag to move">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#141F3B" Offset="0" />
                            <GradientStop Color="#0E1730" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.55" Color="#000000" />
                    </Border.Effect>
                    <Grid Margin="12,0,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding HomeShort}" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding HomeTime}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                            <TextBlock Text="{Binding HomeAmPm}" FontSize="9" Foreground="{StaticResource Accent}" Margin="3,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <Rectangle Grid.Column="1" Width="1" Height="22" Fill="#2B3960" Margin="8,0" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ClientShort}" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding ClientTime}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                            <TextBlock Text="{Binding ClientAmPm}" FontSize="9" Foreground="{StaticResource Muted}" Margin="3,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Grid.Column="3" FontFamily="{StaticResource IconFont}" Text="&#xE70E;" FontSize="11"
                                   Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,2,0" />
                    </Grid>
                </Border>
            </Grid>
        </Viewbox>

        <!-- Client switcher -->
        <Popup x:Name="ClientPopup" PlacementTarget="{Binding ElementName=RootGrid}" Placement="Bottom"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
               IsOpen="{Binding IsClientListOpen, Mode=TwoWay}" Closed="OnPopupClosed">
            <Border Width="300" Margin="8,2,8,12" Padding="6" CornerRadius="12" Background="#151F3D" BorderBrush="#2B3960" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.5" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="SWITCH CLIENT CLOCK" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="10,6,0,4" />
                    <ItemsControl ItemsSource="{Binding Clients}" MaxHeight="260">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ClientRowButton}"
                                        Command="{Binding DataContext.SelectClientCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{StaticResource Accent}" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Label}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                                            <TextBlock Text="{Binding OffsetText}" FontSize="10.5" Foreground="{StaticResource Muted}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding TimeText}" FontSize="12.5" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No clients yet. Add one in the dashboard." FontSize="11.5" Foreground="{StaticResource Muted}" Margin="10,8,10,8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Clients.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>

