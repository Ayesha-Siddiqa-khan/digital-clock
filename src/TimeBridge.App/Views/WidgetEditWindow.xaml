<ui:FluentWindow x:Class="TimeBridge.App.Views.WidgetEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Edit clock" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" Topmost="True"
        WindowStartupLocation="CenterScreen" Icon="pack://application:,,,/Assets/app.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="TimeBridge · Edit clock" ShowMaximize="False" ShowMinimize="False" />
        <StackPanel Grid.Row="1" Margin="28,8,28,24">
            <TextBlock Text="Edit clock" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Choose the time zones shown on the widget." Margin="0,2,0,16"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <TextBlock Text="Your time zone (shown first)" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
            <ComboBox ItemsSource="{Binding Zones}" DisplayMemberPath="Label" SelectedValuePath="Id"
                      SelectedValue="{Binding HomeZoneId}" HorizontalAlignment="Stretch" />

            <TextBlock Text="Client" FontWeight="SemiBold" FontSize="12" Margin="0,14,0,4" />
            <ComboBox ItemsSource="{Binding ClientChoices}" DisplayMemberPath="Name" SelectedValuePath="Id"
                      SelectedValue="{Binding ClientId}" HorizontalAlignment="Stretch" />

            <TextBlock Text="Client time zone" FontWeight="SemiBold" FontSize="12" Margin="0,14,0,4" />
            <ComboBox ItemsSource="{Binding Zones}" DisplayMemberPath="Label" SelectedValuePath="Id"
                      SelectedValue="{Binding ClientZoneId}" HorizontalAlignment="Stretch" />
            <TextBlock Text="Daylight saving changes are applied automatically." FontSize="11" Margin="0,4,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <CheckBox Content="Show seconds" IsChecked="{Binding ShowSeconds}" Margin="0,16,0,0" />

            <TextBlock Text="Widget opacity" FontWeight="SemiBold" FontSize="12" Margin="0,12,0,4" />
            <Slider Minimum="0.4" Maximum="1" Value="{Binding Opacity}" TickFrequency="0.05" IsSnapToTickEnabled="True" />

            <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,10,0,0"
                       Visibility="{Binding Error, Converter={StaticResource NotNullToVis}}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" MinWidth="90" />
                <ui:Button Content="Save" Appearance="Primary" Command="{Binding SaveCommand}" MinWidth="90" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
