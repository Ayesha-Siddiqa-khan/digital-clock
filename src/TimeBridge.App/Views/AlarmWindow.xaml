<ui:FluentWindow x:Class="TimeBridge.App.Views.AlarmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Meeting reminder" Width="440" SizeToContent="Height" MinHeight="300"
        Topmost="True" ResizeMode="NoResize" WindowStartupLocation="Manual"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
        Icon="pack://application:,,,/Assets/app.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="TimeBridge · Reminder" ShowMaximize="False" ShowMinimize="False" />
        <StackPanel Grid.Row="1" Margin="28,10,28,26">
            <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7ED;" FontSize="20"
                           Foreground="{StaticResource AccentSoft}" VerticalAlignment="Center" />
                <TextBlock Text="MEETING REMINDER" Margin="10,0,0,0" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="TitleText" Margin="0,12,0,0" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="CountdownText" Margin="0,4,0,0" FontSize="15" Foreground="{StaticResource AccentSoft}" />

            <Border Margin="0,18,0,0" Padding="16,12" CornerRadius="10"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition /><RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="HomeLabel" Grid.Row="0" Margin="0,0,18,6"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="HomeValue" Grid.Row="0" Grid.Column="1" FontWeight="SemiBold" />
                    <TextBlock x:Name="ClientLabel" Grid.Row="1" Margin="0,0,18,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="ClientValue" Grid.Row="1" Grid.Column="1" FontWeight="SemiBold" />
                </Grid>
            </Border>

            <Grid Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="SnoozeBox" Grid.Column="0" MinWidth="110" />
                <Button Grid.Column="1" Content="Snooze" Margin="8,0,0,0" Click="OnSnooze" />
                <ui:Button Grid.Column="3" Content="Dismiss" Appearance="Primary" MinWidth="110" Click="OnDismiss" />
            </Grid>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
