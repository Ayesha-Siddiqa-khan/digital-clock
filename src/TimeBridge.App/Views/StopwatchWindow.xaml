<Window x:Class="TimeBridge.App.Views.StopwatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TimeBridge Stopwatch" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Topmost="{Binding IsPinned}" Width="320" SizeToContent="Height"
        Icon="pack://application:,,,/Assets/app.ico">
    <Window.Resources>
        <Style x:Key="SwIcon" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#C7D2FE" />
        </Style>
    </Window.Resources>

    <Border Margin="8" CornerRadius="16" BorderThickness="1" BorderBrush="#2B3960" MouseLeftButtonDown="OnDrag">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#141F3B" Offset="0" />
                <GradientStop Color="#0E1730" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.55" Color="#000000" />
        </Border.Effect>
        <StackPanel Margin="16,10,16,16">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE916;" FontSize="14" Foreground="#A5B4FC" VerticalAlignment="Center" />
                    <TextBlock Text="Stopwatch" Margin="8,0,0,0" FontSize="13" FontWeight="SemiBold" Foreground="#F1F5F9" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="PinButton" Style="{StaticResource SwIcon}" Content="&#xE718;" Command="{Binding TogglePinCommand}" ToolTip="Keep on top" />
                    <Button Style="{StaticResource SwIcon}" Content="&#xE8BB;" Click="OnHide" ToolTip="Hide (the stopwatch keeps running)" />
                </StackPanel>
            </Grid>

            <TextBlock Text="{Binding TimeText}" FontSize="44" FontWeight="SemiBold" Foreground="#A5B4FC"
                       HorizontalAlignment="Center" Margin="0,14,0,14" FontFamily="Consolas" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="{Binding StartPauseText}" Command="{Binding StartPauseCommand}"
                        HorizontalAlignment="Stretch" Padding="0,8" Background="#4F46E5" Foreground="White" FontWeight="SemiBold" />
                <Button Grid.Column="2" Content="Lap" Command="{Binding LapCommand}" HorizontalAlignment="Stretch" Padding="0,8"
                        IsEnabled="{Binding IsRunning}" />
                <Button Grid.Column="4" Content="Reset" Command="{Binding ResetCommand}" HorizontalAlignment="Stretch" Padding="0,8"
                        IsEnabled="{Binding HasTime}" />
            </Grid>

            <ScrollViewer MaxHeight="130" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Laps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12" Foreground="#8B9BC0" Margin="0,2" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>
    </Border>
</Window>
