<ui:FluentWindow x:Class="TimeBridge.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:ctl="clr-namespace:TimeBridge.App.Controls"
        Title="TimeBridge" Width="1220" Height="800" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
        Icon="pack://application:,,,/Assets/app.ico">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,14,0,5" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="Eyebrow" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="Pill" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="9,2" />
            <Setter Property="Background" Value="#262F5C" />
        </Style>

        <!-- one meeting row, shared by Overview and Meetings pages -->
        <DataTemplate x:Key="MeetingCard">
            <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="320" />
                            <Border Style="{StaticResource Pill}" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatusText}" FontSize="10.5" FontWeight="SemiBold" Foreground="#C7D2FE" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding ClientLabel}" Style="{StaticResource Hint}" Margin="0,2,0,6" />
                        <TextBlock FontSize="12.5"><Run Text="Pakistan  " Foreground="{DynamicResource TextFillColorSecondaryBrush}" /><Run Text="{Binding HomeWhen, Mode=OneWay}" /></TextBlock>
                        <TextBlock FontSize="12.5" Margin="0,2,0,0"><Run Text="Client      " Foreground="{DynamicResource TextFillColorSecondaryBrush}" /><Run Text="{Binding ClientWhen, Mode=OneWay}" /></TextBlock>
                        <TextBlock Text="{Binding ReminderText}" Style="{StaticResource Hint}" Margin="0,6,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding Countdown}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentSoft}" HorizontalAlignment="Right" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Right">
                            <Button Content="Edit" Margin="0,0,6,0" Padding="12,4"
                                    Command="{Binding DataContext.EditMeetingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}" />
                            <Button Content="Cancel meeting" Margin="0,0,6,0" Padding="12,4"
                                    Command="{Binding DataContext.Meetings.CancelMeetingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}" />
                            <Button Content="Delete" Padding="12,4"
                                    Command="{Binding DataContext.Meetings.DeleteMeetingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="TimeBridge" ShowMinimize="True" ShowMaximize="True"
                     Icon="pack://application:,,,/Assets/app.png" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation -->
            <DockPanel Grid.Column="0" Margin="14,6,6,16" LastChildFill="False">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,4,0,22">
                    <Image Source="pack://application:,,,/Assets/app.png" Width="34" Height="34" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="TimeBridge" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="Dashboard" Style="{StaticResource Hint}" />
                    </StackPanel>
                </StackPanel>

                <ListBox DockPanel.Dock="Top" SelectedIndex="{Binding NavIndex}" Background="Transparent" BorderThickness="0">
                    <ListBoxItem Padding="12,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE80F;" FontSize="16" Width="26" VerticalAlignment="Center" />
                            <TextBlock Text="Overview" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Padding="12,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE787;" FontSize="16" Width="26" VerticalAlignment="Center" />
                            <TextBlock Text="Meetings" FontSize="14" VerticalAlignment="Center" />
                            <Border Margin="10,0,0,0" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource Pill}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UpcomingCount}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding UpcomingCount}" FontSize="10.5" FontWeight="SemiBold" Foreground="#C7D2FE" />
                            </Border>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Padding="12,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE716;" FontSize="16" Width="26" VerticalAlignment="Center" />
                            <TextBlock Text="Clients" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Padding="12,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE713;" FontSize="16" Width="26" VerticalAlignment="Center" />
                            <TextBlock Text="Settings" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>

                <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="14">
                    <StackPanel>
                        <TextBlock Text="CLOCK WIDGET" Style="{StaticResource Eyebrow}" />
                        <TextBlock Margin="0,6,0,10">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                    <Setter Property="Text" Value="Hidden. Alarms keep running." />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WidgetShown}" Value="True">
                                            <Setter Property="Text" Value="Visible on your desktop." />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ui:Button Command="{Binding ToggleWidgetCommand}" HorizontalAlignment="Stretch" Appearance="Secondary">
                            <ui:Button.Style>
                                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                    <Setter Property="Content" Value="Show widget" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WidgetShown}" Value="True">
                                            <Setter Property="Content" Value="Hide widget" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>
                        <Button Content="Exit TimeBridge" Command="{Binding ExitAppCommand}" HorizontalAlignment="Stretch" Margin="0,8,0,0" ToolTip="Quit completely (stops alarms)" />
                    </StackPanel>
                </Border>
            </DockPanel>

            <!-- Pages -->
            <TabControl Grid.Column="1" SelectedIndex="{Binding NavIndex}" BorderThickness="0" Background="Transparent" Padding="0">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <ContentPresenter ContentSource="SelectedContent" />
                    </ControlTemplate>
                </TabControl.Template>

                <!-- Overview -->
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="20,10,32,28">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="DESKTOP UTILITY" Style="{StaticResource Eyebrow}" />
                                <TextBlock Text="Every time zone. One glance." Style="{StaticResource PageTitle}" Margin="0,4,0,0" />
                                <TextBlock Text="Live Pakistan time next to your selected client, plus every upcoming meeting and alarm."
                                           Style="{StaticResource Hint}" Margin="0,6,0,0" />
                            </StackPanel>

                            <Grid Grid.Row="1" Margin="0,22,0,0" DataContext="{Binding Clock}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="1.1*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding HomeLabel}" FontWeight="SemiBold" />
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBlock Text="{Binding HomeTime}" FontSize="40" FontWeight="SemiBold" Foreground="{StaticResource AccentSoft}" />
                                            <TextBlock Text="{Binding HomeAmPm}" FontSize="16" FontWeight="SemiBold" Margin="8,0,0,8" VerticalAlignment="Bottom" Foreground="{StaticResource AccentSoft}" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Hint}"><Run Text="{Binding HomeDate, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding HomeOffset, Mode=OneWay}" /></TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <ComboBox ItemsSource="{Binding Clients}" DisplayMemberPath="Label" SelectedItem="{Binding Selected}"
                                                  HorizontalAlignment="Stretch" ToolTip="Client shown on the widget" />
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBlock Text="{Binding ClientTime}" FontSize="40" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding ClientAmPm}" FontSize="16" FontWeight="SemiBold" Margin="8,0,0,8" VerticalAlignment="Bottom" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Hint}"><Run Text="{Binding ClientDate, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding ClientOffset, Mode=OneWay}" /></TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="4" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="NEXT MEETING" Style="{StaticResource Eyebrow}" />
                                            <TextBlock Text="{Binding NextCountdown}" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="{StaticResource AccentSoft}" />
                                        </Grid>
                                        <TextBlock Text="{Binding NextTitle}" FontSize="19" FontWeight="SemiBold" Margin="0,10,0,0" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding NextDetail}" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid Grid.Row="2" Margin="0,28,0,0">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="Upcoming meetings" FontSize="18" FontWeight="SemiBold" />
                                    <ui:Button Content="+ Plan a meeting" Appearance="Primary" HorizontalAlignment="Right"
                                               Command="{Binding NavigateCommand}" CommandParameter="1" />
                                </Grid>
                                <StackPanel Grid.Row="1">
                                    <ItemsControl ItemsSource="{Binding Upcoming}" ItemTemplate="{StaticResource MeetingCard}" />
                                    <TextBlock Text="No upcoming meetings. Plan one to set an alarm.">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Upcoming.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <!-- Meetings -->
                <TabItem>
                    <Grid x:Name="MeetingsPage" DataContext="{Binding Meetings}" Margin="20,10,32,28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="430" />
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="{Binding FormTitle}" FontSize="18" FontWeight="SemiBold" />
                                        <Border Style="{StaticResource Pill}" HorizontalAlignment="Right">
                                            <TextBlock Text="TIME CONVERTER" FontSize="10" FontWeight="SemiBold" Foreground="#C7D2FE" />
                                        </Border>
                                    </Grid>

                                    <TextBlock Text="Meeting name" Style="{StaticResource FieldLabel}" />
                                    <ui:TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="e.g. Client catch-up" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Date (DD-MM-YYYY)" Style="{StaticResource FieldLabel}" />
                                            <ctl:DateField Value="{Binding Date, Mode=TwoWay}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Style="{StaticResource FieldLabel}"><Run Text="{Binding HomeLabel, Mode=OneWay}" /><Run Text=" time" /></TextBlock>
                                            <ctl:TimePicker Value="{Binding Time, Mode=TwoWay}" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Client's city / time zone" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding ClientChoices}" SelectedValuePath="Id" SelectedValue="{Binding SelectedClientId}"
                                              HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock><Run Text="{Binding Name, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding City, Mode=OneWay}" /></TextBlock>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <TextBlock Text="Alarm reminder" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding ReminderChoices}" DisplayMemberPath="Label" SelectedValuePath="Minutes"
                                              SelectedValue="{Binding ReminderMinutes}" HorizontalAlignment="Stretch" />

                                    <Border Margin="0,16,0,0" Padding="16,12" CornerRadius="10" Background="#141C36" BorderBrush="#2B3960" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="{Binding PreviewIntro}" Style="{StaticResource Hint}" />
                                            <TextBlock Text="{Binding PreviewTime}" FontSize="30" FontWeight="SemiBold" Margin="0,4,0,2" />
                                            <TextBlock Text="{Binding PreviewDetail}" Style="{StaticResource Hint}" />
                                            <TextBlock Text="{Binding PreviewError}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" FontSize="12"
                                                       Visibility="{Binding PreviewError, Converter={StaticResource NotNullToVis}}" />
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="Notes (optional)" Style="{StaticResource FieldLabel}" />
                                    <ui:TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56" MaxHeight="110" />

                                    <TextBlock Text="{Binding FormError}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,12,0,0"
                                               Visibility="{Binding FormError, Converter={StaticResource NotNullToVis}}" />
                                    <TextBlock Text="{Binding StatusMessage}" Foreground="#4ADE80" TextWrapping="Wrap" Margin="0,12,0,0"
                                               Visibility="{Binding StatusMessage, Converter={StaticResource NotNullToVis}}" />

                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:Button Content="{Binding SaveText}" Command="{Binding SaveCommand}" Appearance="Primary" HorizontalAlignment="Stretch" />
                                        <Button Grid.Column="2" Content="Copy time" Command="{Binding CopyTimeCommand}" Padding="16,6" />
                                    </Grid>
                                    <Button Content="Cancel editing" Command="{Binding CancelEditCommand}" HorizontalAlignment="Stretch" Margin="0,8,0,0"
                                            Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </Border>
                        </ScrollViewer>

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Grid Margin="0,0,0,14">
                                <TextBlock Text="Meetings" FontSize="22" FontWeight="SemiBold" />
                                <CheckBox Content="Show past and cancelled" IsChecked="{Binding ShowAll}" HorizontalAlignment="Right" />
                            </Grid>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding Meetings}" ItemTemplate="{StaticResource MeetingCard}" />
                                    <TextBlock Text="No meetings yet. Use the form to schedule one.">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Meetings.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- Clients -->
                <TabItem>
                    <Grid x:Name="ClientsPage" DataContext="{Binding Clients}" Margin="20,10,32,28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="400" />
                        </Grid.ColumnDefinitions>

                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="Clients" FontSize="22" FontWeight="SemiBold" />
                                <TextBlock Text="Click a client to edit it. Daylight saving is applied automatically for every time zone." Style="{StaticResource Hint}" Margin="0,4,0,0" />
                            </StackPanel>
                            <ListBox Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" Background="Transparent"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,0,0,8" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="16,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" FontSize="15" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding ZoneLabel}" Style="{StaticResource Hint}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding TimeText}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource AccentSoft}" HorizontalAlignment="Right" />
                                                <TextBlock HorizontalAlignment="Right" Style="{StaticResource Hint}"><Run Text="{Binding DateText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding OffsetText, Mode=OneWay}" /></TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                        <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="{Binding FormTitle}" FontSize="18" FontWeight="SemiBold" />
                                    <Button Content="New" Command="{Binding NewCommand}" HorizontalAlignment="Right" Padding="12,3"
                                            Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                                <TextBlock Text="Client name" Style="{StaticResource FieldLabel}" />
                                <ui:TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="e.g. Acme Ltd" />
                                <TextBlock Text="City" Style="{StaticResource FieldLabel}" />
                                <ui:TextBox Text="{Binding City, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="e.g. London" />
                                <TextBlock Text="Time zone" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding Zones}" DisplayMemberPath="Label" SelectedValuePath="Id"
                                          SelectedValue="{Binding ZoneId}" HorizontalAlignment="Stretch" />
                                <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,12,0,0"
                                           Visibility="{Binding Error, Converter={StaticResource NotNullToVis}}" />
                                <ui:Button Content="{Binding SaveText}" Command="{Binding SaveCommand}" Appearance="Primary"
                                           HorizontalAlignment="Stretch" Margin="0,18,0,0" />
                                <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                                    <Button Content="Show this client on the widget" Command="{Binding UseInWidgetCommand}" HorizontalAlignment="Stretch" Margin="0,8,0,0" />
                                    <Button Content="Delete client" Command="{Binding DeleteCommand}" HorizontalAlignment="Stretch" Margin="0,8,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Settings -->
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel DataContext="{Binding Settings}" Margin="20,10,32,28" MaxWidth="760" HorizontalAlignment="Left">
                            <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold" />

                            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="Clock" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="Your time zone" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding Zones}" DisplayMemberPath="Label" SelectedValuePath="Id"
                                              SelectedValue="{Binding HomeZoneId}" HorizontalAlignment="Stretch" />
                                    <TextBlock Text="Meeting times you enter are in this zone. Default: Pakistan (Asia/Karachi)." Style="{StaticResource Hint}" Margin="0,4,0,0" />
                                    <CheckBox Content="Show seconds on the clocks" IsChecked="{Binding ShowSeconds}" Margin="0,14,0,0" />
                                    <TextBlock Text="Widget opacity" Style="{StaticResource FieldLabel}" />
                                    <Slider Minimum="0.4" Maximum="1" Value="{Binding Opacity}" TickFrequency="0.05" IsSnapToTickEnabled="True" />
                                    <CheckBox Content="Start TimeBridge when I sign in to Windows" IsChecked="{Binding StartWithWindows}" Margin="0,14,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="Alarms" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="Default reminder for new meetings" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding ReminderChoices}" DisplayMemberPath="Label" SelectedValuePath="Minutes"
                                              SelectedValue="{Binding DefaultReminder}" HorizontalAlignment="Left" MinWidth="240" />
                                    <TextBlock Text="Default snooze (minutes)" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding SnoozeChoices}" SelectedItem="{Binding SnoozeMinutes}" HorizontalAlignment="Left" MinWidth="120" />
                                    <CheckBox Content="Play an alarm sound" IsChecked="{Binding AlarmSound}" Margin="0,14,0,0" />
                                    <Button Content="Test alarm" Command="{Binding TestAlarmCommand}" Margin="0,14,0,0" HorizontalAlignment="Left" Padding="16,6" />
                                    <TextBlock Text="Alarms run in the background, even when the dashboard is minimised or the widget is hidden. Closing the dashboard keeps TimeBridge in the system tray; use Exit in the tray menu to quit."
                                               Style="{StaticResource Hint}" Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="Widget" FontSize="16" FontWeight="SemiBold" />
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Content="Show widget" Command="{Binding ShowWidgetCommand}" Padding="16,6" />
                                        <Button Content="Reset widget position" Command="{Binding ResetWidgetCommand}" Padding="16,6" Margin="8,0,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="About" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"><Run Text="TimeBridge " /><Run Text="{Binding Version, Mode=OneWay}" /></TextBlock>
                                    <TextBlock Text="{Binding DatabasePath}" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                                    <Button Content="Open data folder" Command="{Binding OpenDataFolderCommand}" Margin="0,10,0,0" HorizontalAlignment="Left" Padding="16,6" />
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                <ui:Button Content="Save settings" Appearance="Primary" Command="{Binding SaveCommand}" Padding="22,7" />
                                <TextBlock Text="{Binding Status}" Foreground="#4ADE80" VerticalAlignment="Center" Margin="14,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</ui:FluentWindow>


